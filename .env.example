# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = talk to the local emulators (firebase emulators:start) instead of production
VITE_USE_EMULATORS=false

# false = hide the built-in demo songs and show only songs published from /admin
VITE_INCLUDE_DEMO_SONGS=true
