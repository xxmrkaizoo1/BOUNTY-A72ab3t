    "deploy:all": "npm run build && firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "firebase": "^13.4.0"
  }
}
